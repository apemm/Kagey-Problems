\ Row 3 (A-ROW3), a(n) for n >= 1.
my(x='x+O('x^30)); Vec((x - 3*x^2 - 34*x^3 + 228*x^4 - 641*x^5 + 1307*x^6 - 2186*x^7 + 2056*x^8 - 236*x^9 - 1060*x^10 + 2584*x^11 - 4264*x^12 - 1440*x^13 + 704*x^14 - 1024*x^15 + 2080*x^16 + 2176*x^17 + 384*x^18)/((1-3*x)^3*(1-2*x-2*x^2)^3*(1+2*x^2)^3))

\ Orbits of the 3 X n optima (A-ORB3), a(n) for n >= 1.
my(x='x+O('x^30)); Vec(x*(1 - 11*x + 40*x^2 - 24*x^3 - 177*x^4 + 383*x^5 - 257*x^6 + 163*x^7 + 809*x^8 - 2202*x^9 - 2918*x^10 + 2958*x^11 + 12261*x^12 - 3496*x^13 + 4315*x^14 - 24275*x^15 - 39018*x^16 + 30876*x^17 + 38988*x^18 - 9604*x^19 + 32060*x^20 - 11536*x^21 - 30904*x^22 + 100264*x^23 + 41200*x^24 - 85584*x^25 - 116448*x^26 - 151200*x^27 - 112896*x^28 - 29376*x^29)/((1-3*x)^3*(1+2*x^2)^3*(1-3*x^2)^2*(1+2*x^4)*(1-2*x-2*x^2)^3*(1-2*x^2-2*x^4)))

\ E(n) (A-E3), a(n) for n >= 3.
my(x='x+O('x^30)); Vec(x^3*(43 - 90*x + 128*x^2 - 344*x^3 + 44*x^4 + 80*x^5 + 328*x^6 + 1728*x^7 + 1888*x^8 + 2208*x^9 + 2016*x^10 + 640*x^11)/((1-2*x-2*x^2)^3*(1+2*x^2)^3))
