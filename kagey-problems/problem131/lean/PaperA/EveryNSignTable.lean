/-- **Remark 3.9** (`rem:sign`), the complete sign pattern: `z_N > ζ_N` for `2 ≤ N ≤ 15`,
`z_N < ζ_N` for `16 ≤ N ≤ 218` and `z_N > ζ_N` for `N ≥ 219`, where `z_N = N(1 - p_N)`. -/
theorem rem_sign (N : ℕ) (hN : 2 ≤ N) :
    (N ≤ 15 → zetaN N < (N : ℝ) * (1 - pN N)) ∧
      (16 ≤ N → N ≤ 218 → (N : ℝ) * (1 - pN N) < zetaN N) ∧
      (219 ≤ N → zetaN N < (N : ℝ) * (1 - pN N)) := by
  rcases Nat.lt_or_ge N 2774 with h | h
  · obtain ⟨hA, hB⟩ := sign_table N hN (by omega)
    refine ⟨fun h15 => hA ?_, fun h16 h218 => hB ?_, fun h219 => hA ?_⟩ <;>
      simp [signAbove] <;> omega
  · have := every_N_crossing_above_zeta N h
    exact ⟨fun h15 => by omega, fun _ h218 => by omega, fun _ => this⟩

end Kagey131
