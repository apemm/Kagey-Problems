/-- **Remark 3.9** for `2 ≤ N ≤ 2773`, from the certificate tables. -/
theorem sign_table (N : ℕ) (hN : 2 ≤ N) (hN' : N ≤ 2773) :
    (signAbove N = true → zetaN N < (N : ℝ) * (1 - pN N)) ∧
      (signAbove N = false → (N : ℝ) * (1 - pN N) < zetaN N) := by
  by_cases h1 : N < 200
  · exact sign_of_check signCheck1 hN (by omega) (by rw [signTable1_length]; omega)
  by_cases h2 : N < 398
  · exact sign_of_check signCheck2 hN (by omega) (by rw [signTable2_length]; omega)
  by_cases h3 : N < 596
  · exact sign_of_check signCheck3 hN (by omega) (by rw [signTable3_length]; omega)
