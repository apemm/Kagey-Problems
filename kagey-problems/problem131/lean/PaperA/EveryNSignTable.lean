import PaperA.EveryNSign

/-!
# Remark `rem:sign` for `2 ≤ N ≤ 2773`: kernel-checked sign certificates

For each `N` the certificate is a rational `r = n/10⁷` that separates `z_N = N(1 - p_N)` from
`ζ_N`. The side of `ζ_N` is checked with Taylor bounds for `exp` at `n/(32·10⁷)` raised to the
power `64` and `π` to twenty decimals, and the side of `z_N` by the sign of `S_N(n/(10⁷N - n)) - 1`
as an integer comparison. `SnumFast` evaluates the numerator `Snum` with `O(N)` big-number
operations. The certificates were found numerically and are checked by the kernel.
-/

namespace Kagey131

open Finset

/-! ### A fast evaluation of `Snum` -/

/-- After `i` pairs: `(Σ_{j<2i} W_j x^j y^(2i-1-j), x^(2i), C(A,i), C(B,i), C(A,i-1), C(B,i-1))`. -/
def SAcc (A B x y : ℕ) : ℕ → ℕ × ℕ × ℕ × ℕ × ℕ × ℕ
  | 0 => (0, 1, 1, 1, 0, 0)
  | i + 1 =>
    let s := SAcc A B x y i
    ((s.1 * y + (s.2.2.1 * s.2.2.2.2.2 + s.2.2.2.2.1 * s.2.2.2.1) * s.2.1) * y +
        2 * s.2.2.1 * s.2.2.2.1 * s.2.1 * x,
      s.2.1 * x * x, s.2.2.1 * (A - i) / (i + 1), s.2.2.2.1 * (B - i) / (i + 1),
      s.2.2.1, s.2.2.2.1)

/-- `Snum` computed with `O(N)` big-number operations. -/
def SnumFast (N x y : ℕ) : ℕ :=
  let s := SAcc (N / 2 - 1) (N - N / 2 - 1) x y (N / 2)
  if N % 2 = 0 then s.1
  else s.1 * y + (s.2.2.1 * s.2.2.2.2.2 + s.2.2.2.2.1 * s.2.2.2.1) * s.2.1

/-- The coefficient `W` with `A = k - 1` and `B = N - k - 1`. -/
def Wab (A B j : ℕ) : ℕ :=
  if j = 0 then 0
  else if j % 2 = 1 then 2 * Nat.choose A (j / 2) * Nat.choose B (j / 2)
  else Nat.choose A (j / 2) * Nat.choose B (j / 2 - 1) + Nat.choose A (j / 2 - 1) * Nat.choose B (j / 2)

theorem W_eq_Wab (N k j : ℕ) : W N k j = Wab (k - 1) (N - k - 1) j := rfl

theorem choose_succ_div (n k : ℕ) : Nat.choose n k * (n - k) / (k + 1) = Nat.choose n (k + 1) := by
  rw [← Nat.choose_succ_right_eq]; exact Nat.mul_div_cancel _ (Nat.succ_pos k)

theorem SAcc_spec (A B x y i : ℕ) :
    SAcc A B x y i = (∑ j ∈ range (2 * i), Wab A B j * x ^ j * y ^ (2 * i - 1 - j), x ^ (2 * i),
      Nat.choose A i, Nat.choose B i, if i = 0 then 0 else Nat.choose A (i - 1),
      if i = 0 then 0 else Nat.choose B (i - 1)) := by
  induction i with
  | zero => simp [SAcc]
  | succ i ih =>
    rw [SAcc, ih]
    simp only [choose_succ_div, Nat.add_sub_cancel, if_neg (Nat.succ_ne_zero i)]
    refine Prod.ext ?_ (Prod.ext ?_ rfl)
    · simp only
      rw [show 2 * (i + 1) = 2 * i + 1 + 1 by ring, Finset.sum_range_succ, Finset.sum_range_succ]
      have hW0 : Wab A B (2 * i) = Nat.choose A i * (if i = 0 then 0 else Nat.choose B (i - 1)) +
          (if i = 0 then 0 else Nat.choose A (i - 1)) * Nat.choose B i := by
        unfold Wab
        rcases Nat.eq_zero_or_pos i with rfl | hi
        · simp
        · have h1 : 2 * i ≠ 0 := by omega
          have h2 : ¬ (2 * i % 2 = 1) := by omega
          have h3 : i ≠ 0 := by omega
          simp only [h1, h2, h3, if_false]
          rw [show 2 * i / 2 = i by omega]
      have hW1 : Wab A B (2 * i + 1) = 2 * Nat.choose A i * Nat.choose B i := by
        unfold Wab
        rw [if_neg (by omega), if_pos (by omega), show (2 * i + 1) / 2 = i by omega]
      rw [hW0, hW1, show 2 * i + 1 + 1 - 1 - (2 * i) = 1 by omega,
        show 2 * i + 1 + 1 - 1 - (2 * i + 1) = 0 by omega]
      have hs : ∀ j ∈ range (2 * i), Wab A B j * x ^ j * y ^ (2 * i - 1 - j) * y * y =
          Wab A B j * x ^ j * y ^ (2 * i + 1 + 1 - 1 - j) := by
        intro j hj
        simp only [Finset.mem_range] at hj
        rw [show 2 * i + 1 + 1 - 1 - j = (2 * i - 1 - j) + 1 + 1 by omega, pow_succ, pow_succ]
        ring
      have hsum : (∑ j ∈ range (2 * i), Wab A B j * x ^ j * y ^ (2 * i - 1 - j)) * y * y =
          ∑ j ∈ range (2 * i), Wab A B j * x ^ j * y ^ (2 * i + 1 + 1 - 1 - j) := by
        rw [Finset.sum_mul, Finset.sum_mul]; exact Finset.sum_congr rfl hs
      rw [← hsum]
      ring
    · simp only
      rw [show 2 * (i + 1) = 2 * i + 1 + 1 by ring, pow_succ, pow_succ]

theorem SnumFast_eq (N x y : ℕ) (hN : 2 ≤ N) : SnumFast N x y = Snum N x y := by
  unfold SnumFast Snum
  rw [natSum_eq, SAcc_spec]
  simp only
  have hW : ∀ j, Wfast N (N / 2) j = Wab (N / 2 - 1) (N - N / 2 - 1) j := fun j => by
    rw [Wfast_eq, W_eq_Wab]
  simp_rw [hW]
  rcases Nat.even_or_odd N with ⟨P, hP⟩ | ⟨P, hP⟩
  · rw [if_pos (by omega), show N / 2 = P by omega, show 2 * P = N by omega]
  · rw [if_neg (by omega), show N / 2 = P by omega, if_neg (by omega), if_neg (by omega)]
    rw [show N = 2 * P + 1 by omega, Finset.sum_range_succ, Finset.sum_mul]
    have hs : ∀ j ∈ range (2 * P), Wab (P - 1) (2 * P + 1 - P - 1) j * x ^ j * y ^ (2 * P - 1 - j) * y =
        Wab (P - 1) (2 * P + 1 - P - 1) j * x ^ j * y ^ (2 * P + 1 - 1 - j) := by
      intro j hj
      simp only [Finset.mem_range] at hj
      rw [show 2 * P + 1 - 1 - j = (2 * P - 1 - j) + 1 by omega, pow_succ]
      ring
    rw [Finset.sum_congr rfl hs]
    have hW0 : Wab (P - 1) (2 * P + 1 - P - 1) (2 * P) =
        Nat.choose (P - 1) P * Nat.choose (2 * P + 1 - P - 1) (P - 1) +
          Nat.choose (P - 1) (P - 1) * Nat.choose (2 * P + 1 - P - 1) P := by
      unfold Wab
      rw [if_neg (by omega), if_neg (by omega), show 2 * P / 2 = P by omega]
    rw [hW0, show 2 * P + 1 - 1 - 2 * P = 0 by omega, pow_zero, mul_one]

/-! ### Finer bounds for `exp` and `ζ_N` -/

/-- `q¹⁰ · 10! · 10` times the Taylor upper bound of `exp(p/q)` with ten terms, `q = 32·10⁷`. -/
def expU10 (p : ℕ) : ℕ :=
  36288000 * 320000000 ^ 10 + 36288000 * p * 320000000 ^ 9 + 18144000 * p ^ 2 * 320000000 ^ 8 +
    6048000 * p ^ 3 * 320000000 ^ 7 + 1512000 * p ^ 4 * 320000000 ^ 6 +
    302400 * p ^ 5 * 320000000 ^ 5 + 50400 * p ^ 6 * 320000000 ^ 4 +
    7200 * p ^ 7 * 320000000 ^ 3 + 900 * p ^ 8 * 320000000 ^ 2 + 100 * p ^ 9 * 320000000 +
    11 * p ^ 10

/-- The denominator `q¹⁰ · 10! · 10`. -/
def expU10Den : ℕ := 320000000 ^ 10 * 36288000

/-- `q⁹ · 9!` times the first ten Taylor terms of `exp(p/q)`. -/
def expL10 (p : ℕ) : ℕ :=
  362880 * 320000000 ^ 9 + 362880 * p * 320000000 ^ 8 + 181440 * p ^ 2 * 320000000 ^ 7 +
    60480 * p ^ 3 * 320000000 ^ 6 + 15120 * p ^ 4 * 320000000 ^ 5 + 3024 * p ^ 5 * 320000000 ^ 4 +
    504 * p ^ 6 * 320000000 ^ 3 + 72 * p ^ 7 * 320000000 ^ 2 + 9 * p ^ 8 * 320000000 + p ^ 9

/-- The denominator `q⁹ · 9!`. -/
def expL10Den : ℕ := 320000000 ^ 9 * 362880

theorem exp_le_expU10 {p : ℕ} (hp : p ≤ 320000000) :
    Real.exp ((p : ℝ) / 320000000) ≤ (expU10 p : ℝ) / expU10Den := by
  have hp' : (p : ℝ) ≤ 320000000 := by exact_mod_cast hp
  have h := exp_le_taylor (y := (p : ℝ) / 320000000) (by positivity)
    (by rw [div_le_one (by norm_num)]; exact hp') 10 (by norm_num)
  refine h.trans (le_of_eq ?_)
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.factorial, expU10, expU10Den]
  push_cast
  field_simp
  ring

theorem expL10_le_exp (p : ℕ) :
    (expL10 p : ℝ) / expL10Den ≤ Real.exp ((p : ℝ) / 320000000) := by
  have h := Real.sum_le_exp_of_nonneg (x := (p : ℝ) / 320000000) (by positivity) 10
  refine le_trans (le_of_eq ?_) h
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.factorial, expL10, expL10Den]
  push_cast
  field_simp
  ring

theorem pi_gt_rat20 : (314159265358979323846 / 10 ^ 20 : ℝ) < Real.pi := by
  have := Real.pi_gt_d20; norm_num at this ⊢; linarith

theorem pi_lt_rat20 : Real.pi < (314159265358979323847 / 10 ^ 20 : ℝ) := by
  have := Real.pi_lt_d20; norm_num at this ⊢; linarith

theorem exp_two_mul_eq64 (n : ℕ) :
    Real.exp (2 * ((n : ℝ) / 10 ^ 7)) = Real.exp ((n : ℝ) / 320000000) ^ 64 := by
  rw [← Real.exp_nat_mul]
  congr 1
  push_cast
  ring

/-- `n/10⁷ < ζ_N` from an integer inequality. -/
theorem lt_zetaN_of_cert10 (N n : ℕ) (hN : 1 ≤ N) (hn : n ≤ 320000000)
    (h : 8 * n * expU10 n ^ 64 * 10 ^ 20 ≤
      314159265358979323846 * N ^ 2 * 10 ^ 7 * expU10Den ^ 64) :
    (n : ℝ) / 10 ^ 7 < zetaN N := by
  apply lt_zetaN_of N hN (by positivity)
  have hb := exp_le_expU10 hn
  have hDen : (0 : ℝ) < expU10Den := by norm_num [expU10Den]
  have hcast : (8 * n * expU10 n ^ 64 * 10 ^ 20 : ℝ) ≤
      314159265358979323846 * (N : ℝ) ^ 2 * 10 ^ 7 * (expU10Den : ℝ) ^ 64 := by exact_mod_cast h
  have hN2 : (0 : ℝ) < (N : ℝ) ^ 2 := by
    have : (1 : ℝ) ≤ N := by exact_mod_cast hN
    positivity
  unfold zetaFun
  rw [exp_two_mul_eq64]
  generalize (expU10 n : ℝ) = U at hb hcast
  generalize (expU10Den : ℝ) = D at hb hcast hDen
  have h1 : Real.exp ((n : ℝ) / 320000000) ^ 64 ≤ (U / D) ^ 64 :=
    pow_le_pow_left₀ (Real.exp_pos _).le hb 64
  have h2 : 8 * ((n : ℝ) / 10 ^ 7) * (U / D) ^ 64 ≤
      314159265358979323846 / 10 ^ 20 * (N : ℝ) ^ 2 := by
    rw [div_pow, show 8 * ((n : ℝ) / 10 ^ 7) * (U ^ 64 / D ^ 64) =
      8 * n * U ^ 64 / (10 ^ 7 * D ^ 64) by ring,
      div_le_iff₀ (mul_pos (by norm_num) (pow_pos hDen 64))]
    have : 314159265358979323846 / 10 ^ 20 * (N : ℝ) ^ 2 * (10 ^ 7 * D ^ 64) =
        314159265358979323846 * (N : ℝ) ^ 2 * 10 ^ 7 * D ^ 64 / 10 ^ 20 := by ring
    rw [this, le_div_iff₀ (by norm_num)]
    linarith
  calc 8 * ((n : ℝ) / 10 ^ 7) * Real.exp ((n : ℝ) / 320000000) ^ 64
      ≤ 8 * ((n : ℝ) / 10 ^ 7) * (U / D) ^ 64 := mul_le_mul_of_nonneg_left h1 (by positivity)
    _ ≤ 314159265358979323846 / 10 ^ 20 * (N : ℝ) ^ 2 := h2
    _ < Real.pi * (N : ℝ) ^ 2 := mul_lt_mul_of_pos_right pi_gt_rat20 hN2

/-- `ζ_N < n/10⁷` from an integer inequality. -/
theorem zetaN_lt_of_cert10 (N n : ℕ) (hN : 1 ≤ N)
    (h : 314159265358979323847 * N ^ 2 * 10 ^ 7 * expL10Den ^ 64 ≤
      8 * n * expL10 n ^ 64 * 10 ^ 20) :
    zetaN N < (n : ℝ) / 10 ^ 7 := by
  apply zetaN_lt_of N hN (by positivity)
  have hb := expL10_le_exp n
  have hDen : (0 : ℝ) < expL10Den := by norm_num [expL10Den]
  have hU0 : (0 : ℝ) ≤ expL10 n := Nat.cast_nonneg _
  have hcast : (314159265358979323847 * (N : ℝ) ^ 2 * 10 ^ 7 * (expL10Den : ℝ) ^ 64 : ℝ) ≤
      8 * n * (expL10 n : ℝ) ^ 64 * 10 ^ 20 := by exact_mod_cast h
  have hN2 : (0 : ℝ) < (N : ℝ) ^ 2 := by
    have : (1 : ℝ) ≤ N := by exact_mod_cast hN
    positivity
  unfold zetaFun
  rw [exp_two_mul_eq64]
  generalize (expL10 n : ℝ) = U at hb hcast hU0
  generalize (expL10Den : ℝ) = D at hb hcast hDen
  have h1 : (U / D) ^ 64 ≤ Real.exp ((n : ℝ) / 320000000) ^ 64 :=
    pow_le_pow_left₀ (div_nonneg hU0 hDen.le) hb 64
  have h2 : 314159265358979323847 / 10 ^ 20 * (N : ℝ) ^ 2 ≤
      8 * ((n : ℝ) / 10 ^ 7) * (U / D) ^ 64 := by
    rw [div_pow, show 8 * ((n : ℝ) / 10 ^ 7) * (U ^ 64 / D ^ 64) =
      8 * n * U ^ 64 / (10 ^ 7 * D ^ 64) by ring,
      le_div_iff₀ (mul_pos (by norm_num) (pow_pos hDen 64))]
    have : 314159265358979323847 / 10 ^ 20 * (N : ℝ) ^ 2 * (10 ^ 7 * D ^ 64) =
        314159265358979323847 * (N : ℝ) ^ 2 * 10 ^ 7 * D ^ 64 / 10 ^ 20 := by ring
    rw [this, div_le_iff₀ (by norm_num)]
    linarith
  calc Real.pi * (N : ℝ) ^ 2 < 314159265358979323847 / 10 ^ 20 * (N : ℝ) ^ 2 :=
        mul_lt_mul_of_pos_right pi_lt_rat20 hN2
    _ ≤ 8 * ((n : ℝ) / 10 ^ 7) * (U / D) ^ 64 := h2
    _ ≤ 8 * ((n : ℝ) / 10 ^ 7) * Real.exp ((n : ℝ) / 320000000) ^ 64 :=
        mul_le_mul_of_nonneg_left h1 (by positivity)

/-! ### The side of `z_N` -/

theorem zN_at (N n : ℕ) (hNn : n < N * 10 ^ 7) :
    (N : ℝ) * ((n : ℝ) / ((N * 10 ^ 7 - n : ℕ) : ℝ)) /
        (1 + (n : ℝ) / ((N * 10 ^ 7 - n : ℕ) : ℝ)) = (n : ℝ) / 10 ^ 7 := by
  have hy : (0 : ℝ) < ((N * 10 ^ 7 - n : ℕ) : ℝ) := by
    exact_mod_cast (show 0 < N * 10 ^ 7 - n by omega)
  have e : ((N * 10 ^ 7 - n : ℕ) : ℝ) = (N : ℝ) * 10 ^ 7 - n := by
    rw [Nat.cast_sub hNn.le]; push_cast; ring
  rw [e] at hy ⊢
  have hN : (0 : ℝ) < (N : ℝ) * 10 ^ 7 := by
    have : (n : ℝ) ≥ 0 := Nat.cast_nonneg n
    linarith
  field_simp
  ring

/-- `n/10⁷ < z_N` from `Snum N n y < y^(N-1)` with `y = 10⁷N - n`. -/
theorem lt_zN_of_cert (N n : ℕ) (hN : 2 ≤ N) (hNn : n < N * 10 ^ 7)
    (h : SnumFast N n (N * 10 ^ 7 - n) < (N * 10 ^ 7 - n) ^ (N - 1)) :
    (n : ℝ) / 10 ^ 7 < (N : ℝ) * (1 - pN N) := by
  rw [SnumFast_eq N _ _ hN] at h
  have hy : 0 < N * 10 ^ 7 - n := by omega
  have hy' : (0 : ℝ) < ((N * 10 ^ 7 - n : ℕ) : ℝ) := by exact_mod_cast hy
  have hS : SN N ((n : ℝ) / ((N * 10 ^ 7 - n : ℕ) : ℝ)) < 1 := by
    have e := Snum_eq N n (N * 10 ^ 7 - n) hy
    have hc : (Snum N n (N * 10 ^ 7 - n) : ℝ) < ((N * 10 ^ 7 - n : ℕ) : ℝ) ^ (N - 1) := by
      exact_mod_cast h
    rw [e] at hc
    exact (mul_lt_iff_lt_one_right (pow_pos hy' (N - 1))).1 hc
  have hu : (n : ℝ) / ((N * 10 ^ 7 - n : ℕ) : ℝ) < uN N :=
    (Sab_lt_one_iff (a := N / 2) (b := N - N / 2) (by omega) (by omega) (by positivity)).1 hS
  have hNpos : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  rw [N_one_sub_pN N hN, ← zN_at N n hNn]
  exact zmap_lt hNpos (by positivity) hu

/-- `z_N < n/10⁷` from `y^(N-1) < Snum N n y` with `y = 10⁷N - n`. -/
theorem zN_lt_of_cert (N n : ℕ) (hN : 2 ≤ N) (hNn : n < N * 10 ^ 7)
    (h : (N * 10 ^ 7 - n) ^ (N - 1) < SnumFast N n (N * 10 ^ 7 - n)) :
    (N : ℝ) * (1 - pN N) < (n : ℝ) / 10 ^ 7 := by
  rw [SnumFast_eq N _ _ hN] at h
  have hy : 0 < N * 10 ^ 7 - n := by omega
  have hy' : (0 : ℝ) < ((N * 10 ^ 7 - n : ℕ) : ℝ) := by exact_mod_cast hy
  have hS : 1 < SN N ((n : ℝ) / ((N * 10 ^ 7 - n : ℕ) : ℝ)) := by
    have e := Snum_eq N n (N * 10 ^ 7 - n) hy
    have hc : ((N * 10 ^ 7 - n : ℕ) : ℝ) ^ (N - 1) < (Snum N n (N * 10 ^ 7 - n) : ℝ) := by
      exact_mod_cast h
    rw [e] at hc
    exact (lt_mul_iff_one_lt_right (pow_pos hy' (N - 1))).1 hc
  have hu : uN N < (n : ℝ) / ((N * 10 ^ 7 - n : ℕ) : ℝ) :=
    (one_lt_Sab_iff (a := N / 2) (b := N - N / 2) (by omega) (by omega) (by positivity)).1 hS
  have hNpos : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  rw [N_one_sub_pN N hN, ← zN_at N n hNn]
  exact zmap_lt hNpos (uab_pos (by omega) (by omega)).le hu

/-! ### The certificates -/

/-- The sign pattern of Remark 3.9: `true` where `z_N > ζ_N`. -/
def signAbove (N : ℕ) : Bool := decide (N ≤ 15 ∨ 219 ≤ N)

/-- The certificate for one `N`: `r = n/10⁷` lies strictly between `ζ_N` and `z_N`, in the order
given by `signAbove N`. -/
def signCert (N n : ℕ) : Bool :=
  decide (n ≤ 320000000) && decide (n < N * 10 ^ 7) &&
  (if signAbove N then
    decide (314159265358979323847 * N ^ 2 * 10 ^ 7 * expL10Den ^ 64 ≤
        8 * n * expL10 n ^ 64 * 10 ^ 20) &&
      decide (SnumFast N n (N * 10 ^ 7 - n) < (N * 10 ^ 7 - n) ^ (N - 1))
  else
    decide (8 * n * expU10 n ^ 64 * 10 ^ 20 ≤
        314159265358979323846 * N ^ 2 * 10 ^ 7 * expU10Den ^ 64) &&
      decide ((N * 10 ^ 7 - n) ^ (N - 1) < SnumFast N n (N * 10 ^ 7 - n)))

theorem sign_of_cert {N n : ℕ} (hN : 2 ≤ N) (h : signCert N n = true) :
    (signAbove N = true → zetaN N < (N : ℝ) * (1 - pN N)) ∧
      (signAbove N = false → (N : ℝ) * (1 - pN N) < zetaN N) := by
  unfold signCert at h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨h1, h2⟩, h3⟩ := h
  constructor
  · intro hs
    rw [hs, if_pos rfl] at h3
    simp only [Bool.and_eq_true, decide_eq_true_eq] at h3
    exact (zetaN_lt_of_cert10 N n (by omega) h3.1).trans (lt_zN_of_cert N n hN h2 h3.2)
  · intro hs
    rw [hs] at h3
    simp only [Bool.false_eq_true, if_false, Bool.and_eq_true, decide_eq_true_eq] at h3
    exact (zN_lt_of_cert N n hN h2 h3.2).trans (lt_zetaN_of_cert10 N n (by omega) h1 h3.1)

/-- Check the certificates `l` for `N₀, N₀ + 1, ...`. -/
def signCheck : ℕ → List ℕ → Bool
  | _, [] => true
  | N, n :: l => signCert N n && signCheck (N + 1) l

theorem sign_of_check {N₀ : ℕ} {l : List ℕ} (h : signCheck N₀ l = true) {N : ℕ} (hN : 2 ≤ N)
    (h0 : N₀ ≤ N) (h1 : N < N₀ + l.length) :
    (signAbove N = true → zetaN N < (N : ℝ) * (1 - pN N)) ∧
      (signAbove N = false → (N : ℝ) * (1 - pN N) < zetaN N) := by
  induction l generalizing N₀ with
  | nil => simp at h1; omega
  | cons n l ih =>
    simp only [signCheck, Bool.and_eq_true] at h
    rcases Nat.eq_or_lt_of_le h0 with rfl | hlt
    · exact sign_of_cert hN h.1
    · exact ih h.2 (by omega) (by simp at h1; omega)

